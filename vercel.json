{
  "framework": "nextjs",
  "functions": {
    "app/api/telegram/webhook/route.ts": {
      "maxDuration": 60
    },
    "app/api/chat/respond/route.ts": {
      "maxDuration": 60
    },
    "app/api/receipts/process/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/**": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/briefing",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/daily-insight",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/activity-check",
      "schedule": "0 12 * * *"
    }
  ]
}
